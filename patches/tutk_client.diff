+# Older libIOTCAPIs.so builds (the x86_64 ones in the legacy Owlet Care app)
+# check `cmp [rdx],0x14` instead: the classic 20-byte TUTK layout. Connect
+# tries the 160-byte struct first and falls back to this one on -46.
+class St_IOTCConnectInputLegacy(Structure):
+    _fields_ = [
+        ("structSize", c_int),          # 0x00  must be 20
+        ("authenticationType", c_int),  # 0x04
+        ("authKey", c_char * 8),        # 0x08
+        ("timeout", c_int),             # 0x10
+    ]
+
+
 # --------------------------------------------------------------------------- #
 # SessionModeVer — the struct IOTC_Session_Check() fills in. Standard TUTK
 # IOTCAPIs.h layout: two unsigned ints, no padding.
