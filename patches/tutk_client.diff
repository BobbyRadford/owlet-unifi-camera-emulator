+# avServStart2's auth callback (account, password) -> nonzero to accept. The
+# camera is the only peer on the session, so it accepts any.
+_AUTH_FN = ctypes.CFUNCTYPE(c_int, c_char_p, c_char_p)
+_SPEAKER_AUTH = _AUTH_FN(lambda account, password: 1)
+
