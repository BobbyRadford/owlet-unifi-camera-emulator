# UniFi Protect NVR IP and this host's IP.
PROTECT_NVR_IP=192.168.1.10
CAMERA_HOST_IP=192.168.1.50

# Unused MAC address (12 hex characters) and display name for the emulated camera.
CAMERA_MAC=28704E000002
CAMERA_NAME=Nursery

# One-time adoption token from Protect (/proxy/protect/api/cameras/manage-payload).
# Only needed on first adoption; once adopted Protect accepts restarts without a fresh token.
OWLET_ADOPTION_TOKEN=

# Optional detection tuning.
AI_MIN_CONFIDENCE=0.5
YOLO_EVERY=3
